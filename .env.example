ROOMBA_IP=192.168.1.50
ROOMBA_BLID=CHANGE_ME
ROOMBA_PASSWORD=CHANGE_ME
PORT=8080
# Port published on the Mac (change it if 8080 is already used).
HOST_PORT=8080
# Max wait for one outbound call (command, schedule write).
CALL_TIMEOUT_SECONDS=15
# Wait between attempts while the first connection cannot be made (later drops: roombapy reconnects itself).
RECONNECT_SECONDS=30
# Hours between refreshes of data/snapshots/roombalab-latest.sqlite (also refreshed at startup).
SNAPSHOT_HOURS=24
