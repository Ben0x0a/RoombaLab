ROOMBA_IP=192.168.1.50
ROOMBA_BLID=CHANGE_ME
ROOMBA_PASSWORD=CHANGE_ME
# Port of the web interface on the Mac (change it if 8080 is already used). The only port to set.
HOST_PORT=8080
# Max wait for one outbound call (command, schedule write).
CALL_TIMEOUT_SECONDS=15
# Wait between attempts while the first connection cannot be made (later drops: roombapy reconnects itself).
RECONNECT_SECONDS=30
# Hours between refreshes of data/snapshots/roombalab-latest.sqlite (also refreshed at startup).
SNAPSHOT_HOURS=24
# Retention: when Docker's disk or the Mac's disk is at or above this %, the oldest raw data is archived
# to data/archive (compressed JSONL + SHA-256) then deleted: Wi-Fi signal messages first, then the rest.
DISK_THRESHOLD_PCT=75
# Data younger than this is never deleted, whatever the disk usage.
RETENTION_MIN_DAYS=90
# Hours between disk checks (also checked at startup).
RETENTION_CHECK_HOURS=6
